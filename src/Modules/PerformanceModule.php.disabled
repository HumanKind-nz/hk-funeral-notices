<?php
declare(strict_types=1);

namespace WeaveStudios\FuneralNotices\Modules;

/**
 * Performance Module
 * 
 * Caching, optimization, and performance improvements.
 * Manages query caching, asset optimization, lazy loading,
 * and performance monitoring.
 * 
 * @since 2.0.0
 */
class PerformanceModule extends BaseModule {
    
    protected array $default_settings = [
        'enable_query_caching' => true,
        'cache_duration' => 3600,
        'enable_auto_purge' => true,
        'purge_triggers' => ['post_save', 'post_delete', 'term_update'],
        'enable_asset_optimization' => true,
        'minify_css' => true,
        'minify_js' => true,
        'defer_non_critical_css' => true,
        'defer_javascript' => true,
        'enable_lazy_loading' => true,
        'lazy_load_images' => true,
        'lazy_load_threshold' => 200,
        'enable_database_cleanup' => true,
        'cleanup_frequency' => 'weekly',
        'cleanup_orphaned_meta' => true,
        'cleanup_revisions' => true,
        'cleanup_spam_comments' => true,
        'enable_performance_monitoring' => true,
        'track_query_time' => true,
        'track_memory_usage' => true,
        'performance_threshold' => 1000,
        'enable_cdn_support' => false,
        'cdn_url' => '',
        'enable_gzip_compression' => true,
        'enable_browser_caching' => true,
        'cache_headers_ttl' => 86400,
        'enable_preload' => false,
        'preload_pages' => []
    ];
    
    private array $cache_groups = [
        'funeral_notices' => 'Funeral Notices Data',
        'search_results' => 'Search Results',
        'template_output' => 'Template Output',
        'asset_urls' => 'Asset URLs',
        'api_responses' => 'API Responses'
    ];
    
    private array $cleanup_frequencies = [
        'daily' => 'Daily',
        'weekly' => 'Weekly',
        'monthly' => 'Monthly',
        'manual' => 'Manual Only'
    ];
    
    /**
     * Constructor
     */
    public function __construct() {
        parent::__construct(
            'performance',
            'Performance',
            'Caching, optimization, and performance improvements',
            '2.0.0'
        );
    }
    
    /**
     * Initialize the module
     */
    public function init(): void {
        parent::init();
    }
    
    /**
     * Initialize frontend functionality
     */
    protected function init_frontend(): void {
        $settings = $this->get_settings();
        
        // Initialize caching
        if ($settings['enable_query_caching']) {
            add_action('init', [$this, 'init_caching']);
        }
        
        // Asset optimization
        if ($settings['enable_asset_optimization']) {
            add_action('wp_enqueue_scripts', [$this, 'optimize_assets'], 999);
        }
        
        // Lazy loading
        if ($settings['enable_lazy_loading']) {
            add_filter('the_content', [$this, 'add_lazy_loading']);
            add_filter('post_thumbnail_html', [$this, 'add_lazy_loading_to_thumbnails']);
        }
        
        // Database cleanup
        if ($settings['enable_database_cleanup']) {
            add_action('wp_scheduled_delete', [$this, 'schedule_database_cleanup']);
        }
        
        // Performance monitoring
        if ($settings['enable_performance_monitoring']) {
            add_action('init', [$this, 'init_performance_monitoring']);
        }
        
        // CDN support
        if ($settings['enable_cdn_support'] && !empty($settings['cdn_url'])) {
            add_filter('wp_get_attachment_url', [$this, 'rewrite_url_for_cdn']);
        }
        
        // Browser caching headers
        if ($settings['enable_browser_caching']) {
            add_action('wp_head', [$this, 'add_cache_headers']);
        }
        
        // Admin bar performance info
        if (is_admin_bar_showing()) {
            add_action('admin_bar_menu', [$this, 'add_admin_bar_performance_info'], 999);
        }
    }
    
    /**
     * Get module features
     */
    public function get_features(): array {
        return [
            'Query Caching System with Auto-Purge',
            'Asset Optimization (CSS/JS Minification)',
            'Lazy Loading Images & Content',
            'Database Cleanup Tools',
            'Performance Monitoring & Analytics',
            'CDN Support & Integration',
            'Browser Caching Headers',
            'GZIP Compression Support',
            'Asset Preloading',
            'Memory Usage Tracking'
        ];
    }
    
    /**
     * Initialize caching system
     */
    public function init_caching(): void {
        $settings = $this->get_settings();
        
        // Set up cache purge triggers
        if ($settings['enable_auto_purge']) {
            foreach ($settings['purge_triggers'] as $trigger) {
                switch ($trigger) {
                    case 'post_save':
                        add_action('save_post', [$this, 'purge_cache_on_post_save']);
                        break;
                    case 'post_delete':
                        add_action('delete_post', [$this, 'purge_cache_on_post_delete']);
                        break;
                    case 'term_update':
                        add_action('edited_term', [$this, 'purge_cache_on_term_update']);
                        break;
                }
            }
        }
        
        // Register cache groups
        foreach ($this->cache_groups as $group => $description) {
            wp_cache_add_global_groups($group);
        }
    }
    
    /**
     * Optimize assets
     */
    public function optimize_assets(): void {
        $settings = $this->get_settings();
        
        if ($settings['defer_non_critical_css']) {
            add_filter('style_loader_tag', [$this, 'defer_non_critical_css'], 10, 2);
        }
        
        if ($settings['defer_javascript']) {
            add_filter('script_loader_tag', [$this, 'defer_javascript'], 10, 2);
        }
    }
    
    /**
     * Add lazy loading to content
     */
    public function add_lazy_loading(string $content): string {
        $settings = $this->get_settings();
        
        if (!$settings['lazy_load_images']) {
            return $content;
        }
        
        // Add loading="lazy" to images
        $content = preg_replace_callback(
            '/<img([^>]+)>/i',
            function($matches) use ($settings) {
                $img_tag = $matches[0];
                
                // Skip if loading attribute already exists
                if (strpos($img_tag, 'loading=') !== false) {
                    return $img_tag;
                }
                
                // Add loading="lazy" attribute
                $img_tag = str_replace('<img', '<img loading="lazy"', $img_tag);
                
                return $img_tag;
            },
            $content
        );
        
        return $content;
    }
    
    /**
     * Add lazy loading to thumbnails
     */
    public function add_lazy_loading_to_thumbnails(string $html): string {
        $settings = $this->get_settings();
        
        if (!$settings['lazy_load_images']) {
            return $html;
        }
        
        // Add loading="lazy" to thumbnail images
        if (strpos($html, 'loading=') === false) {
            $html = str_replace('<img', '<img loading="lazy"', $html);
        }
        
        return $html;
    }
    
    /**
     * Schedule database cleanup
     */
    public function schedule_database_cleanup(): void {
        $settings = $this->get_settings();
        
        if (!wp_next_scheduled('wfn_database_cleanup')) {
            $frequency = $settings['cleanup_frequency'];
            if ($frequency !== 'manual') {
                wp_schedule_event(time(), $frequency, 'wfn_database_cleanup');
            }
        }
        
        add_action('wfn_database_cleanup', [$this, 'perform_database_cleanup']);
    }
    
    /**
     * Perform database cleanup
     */
    public function perform_database_cleanup(): void {
        $settings = $this->get_settings();
        
        global $wpdb;
        
        $cleanup_count = 0;
        
        // Clean up orphaned meta
        if ($settings['cleanup_orphaned_meta']) {
            $orphaned_meta = $wpdb->query("
                DELETE pm FROM {$wpdb->postmeta} pm
                LEFT JOIN {$wpdb->posts} p ON pm.post_id = p.ID
                WHERE p.ID IS NULL
            ");
            $cleanup_count += $orphaned_meta;
        }
        
        // Clean up revisions
        if ($settings['cleanup_revisions']) {
            $revisions = $wpdb->query("
                DELETE FROM {$wpdb->posts} 
                WHERE post_type = 'revision'
            ");
            $cleanup_count += $revisions;
        }
        
        // Clean up spam comments
        if ($settings['cleanup_spam_comments']) {
            $spam_comments = $wpdb->query("
                DELETE FROM {$wpdb->comments} 
                WHERE comment_approved = 'spam'
            ");
            $cleanup_count += $spam_comments;
        }
        
        // Log cleanup results
        $this->log_performance_event('database_cleanup', [
            'items_cleaned' => $cleanup_count,
            'timestamp' => current_time('mysql')
        ]);
    }
    
    /**
     * Initialize performance monitoring
     */
    public function init_performance_monitoring(): void {
        $settings = $this->get_settings();
        
        if ($settings['track_query_time']) {
            add_action('shutdown', [$this, 'track_query_performance']);
        }
        
        if ($settings['track_memory_usage']) {
            add_action('shutdown', [$this, 'track_memory_usage']);
        }
    }
    
    /**
     * Track query performance
     */
    public function track_query_performance(): void {
        global $wpdb;
        
        $settings = $this->get_settings();
        
        $total_time = 0;
        $slow_queries = [];
        
        foreach ($wpdb->queries as $query) {
            $query_time = $query[1] * 1000; // Convert to milliseconds
            $total_time += $query_time;
            
            // Track slow queries
            if ($query_time > $settings['performance_threshold']) {
                $slow_queries[] = [
                    'query' => $query[0],
                    'time' => $query_time,
                    'stack' => $query[2] ?? ''
                ];
            }
        }
        
        // Log performance data
        $this->log_performance_event('query_performance', [
            'total_queries' => count($wpdb->queries),
            'total_time' => $total_time,
            'slow_queries' => count($slow_queries),
            'timestamp' => current_time('mysql')
        ]);
        
        // Store slow queries for review
        if (!empty($slow_queries)) {
            update_option('wfn_slow_queries', array_slice($slow_queries, -10), false);
        }
    }
    
    /**
     * Track memory usage
     */
    public function track_memory_usage(): void {
        $memory_usage = memory_get_usage(true);
        $peak_memory = memory_get_peak_usage(true);
        $memory_limit = wp_convert_hr_to_bytes(ini_get('memory_limit'));
        
        $this->log_performance_event('memory_usage', [
            'current_usage' => $memory_usage,
            'peak_usage' => $peak_memory,
            'memory_limit' => $memory_limit,
            'usage_percentage' => ($peak_memory / $memory_limit) * 100,
            'timestamp' => current_time('mysql')
        ]);
    }
    
    /**
     * Log performance event
     */
    private function log_performance_event(string $event_type, array $data): void {
        $performance_log = get_option('wfn_performance_log', []);
        
        $performance_log[] = [
            'type' => $event_type,
            'data' => $data,
            'url' => $_SERVER['REQUEST_URI'] ?? '',
            'user_agent' => $_SERVER['HTTP_USER_AGENT'] ?? ''
        ];
        
        // Keep only last 100 events
        $performance_log = array_slice($performance_log, -100);
        
        update_option('wfn_performance_log', $performance_log, false);
    }
    
    /**
     * Rewrite URLs for CDN
     */
    public function rewrite_url_for_cdn(string $url): string {
        $settings = $this->get_settings();
        
        if (empty($settings['cdn_url'])) {
            return $url;
        }
        
        $upload_dir = wp_upload_dir();
        $base_url = $upload_dir['baseurl'];
        
        if (strpos($url, $base_url) === 0) {
            $url = str_replace($base_url, rtrim($settings['cdn_url'], '/'), $url);
        }
        
        return $url;
    }
    
    /**
     * Add cache headers
     */
    public function add_cache_headers(): void {
        $settings = $this->get_settings();
        
        if (!headers_sent()) {
            header('Cache-Control: public, max-age=' . $settings['cache_headers_ttl']);
            header('Expires: ' . gmdate('D, d M Y H:i:s', time() + $settings['cache_headers_ttl']) . ' GMT');
        }
    }
    
    /**
     * Add admin bar performance info
     */
    public function add_admin_bar_performance_info(\WP_Admin_Bar $wp_admin_bar): void {
        if (!current_user_can('manage_options')) {
            return;
        }
        
        $memory_usage = memory_get_usage(true);
        $memory_limit = wp_convert_hr_to_bytes(ini_get('memory_limit'));
        $memory_percentage = ($memory_usage / $memory_limit) * 100;
        
        $wp_admin_bar->add_node([
            'id' => 'wfn-performance',
            'title' => sprintf('Memory: %.1f%% | Queries: %d', $memory_percentage, get_num_queries()),
            'href' => $this->get_admin_url(),
            'meta' => [
                'title' => 'WFN Performance Monitor'
            ]
        ]);
    }
    
    /**
     * Defer non-critical CSS
     */
    public function defer_non_critical_css(string $html, string $handle): string {
        // List of critical CSS handles that should not be deferred
        $critical_handles = ['wfn-critical', 'admin-bar', 'dashicons'];
        
        if (in_array($handle, $critical_handles)) {
            return $html;
        }
        
        // Add media="print" and onload script to defer CSS
        $html = str_replace('media=\'all\'', 'media=\'print\' onload=\'this.media="all"\'', $html);
        $html = str_replace('media="all"', 'media="print" onload="this.media=\'all\'"', $html);
        
        return $html;
    }
    
    /**
     * Defer JavaScript
     */
    public function defer_javascript(string $tag, string $handle): string {
        // List of scripts that should not be deferred
        $no_defer_handles = ['jquery', 'jquery-core', 'jquery-migrate'];
        
        if (in_array($handle, $no_defer_handles)) {
            return $tag;
        }
        
        // Add defer attribute
        return str_replace('<script', '<script defer', $tag);
    }
    
    /**
     * Get cache statistics
     */
    public function get_cache_statistics(): array {
        $stats = [];
        
        foreach ($this->cache_groups as $group => $description) {
            $stats[$group] = [
                'description' => $description,
                'size' => $this->get_cache_group_size($group),
                'hit_ratio' => $this->get_cache_hit_ratio($group)
            ];
        }
        
        return $stats;
    }
    
    /**
     * Get cache group size
     */
    private function get_cache_group_size(string $group): int {
        // This would need to be implemented based on your caching solution
        // For now, return a placeholder
        return 0;
    }
    
    /**
     * Get cache hit ratio
     */
    private function get_cache_hit_ratio(string $group): float {
        // This would need to be implemented based on your caching solution
        // For now, return a placeholder
        return 0.0;
    }
    
    /**
     * Purge cache on post save
     */
    public function purge_cache_on_post_save(int $post_id): void {
        if (get_post_type($post_id) === 'funeral-notice') {
            $this->purge_cache_group('funeral_notices');
            $this->purge_cache_group('search_results');
            $this->purge_cache_group('template_output');
        }
    }
    
    /**
     * Purge cache on post delete
     */
    public function purge_cache_on_post_delete(int $post_id): void {
        if (get_post_type($post_id) === 'funeral-notice') {
            $this->purge_cache_group('funeral_notices');
            $this->purge_cache_group('search_results');
            $this->purge_cache_group('template_output');
        }
    }
    
    /**
     * Purge cache on term update
     */
    public function purge_cache_on_term_update(int $term_id): void {
        $this->purge_cache_group('funeral_notices');
        $this->purge_cache_group('search_results');
    }
    
    /**
     * Purge cache group
     */
    private function purge_cache_group(string $group): void {
        wp_cache_flush_group($group);
    }
    
