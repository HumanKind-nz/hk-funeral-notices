    /**
     * Sanitize settings with specific validation
     */
    protected function sanitize_settings(array $settings): array {
        $sanitized = [];
        
        // Boolean settings
        $boolean_settings = [
            'enable_query_caching', 'enable_auto_purge', 'enable_asset_optimization',
            'minify_css', 'minify_js', 'defer_non_critical_css', 'defer_javascript',
            'enable_lazy_loading', 'lazy_load_images', 'enable_database_cleanup',
            'cleanup_orphaned_meta', 'cleanup_revisions', 'cleanup_spam_comments',
            'enable_performance_monitoring', 'track_query_time', 'track_memory_usage',
            'enable_cdn_support', 'enable_gzip_compression', 'enable_browser_caching',
            'enable_preload'
        ];
        
        foreach ($boolean_settings as $setting) {
            $sanitized[$setting] = !empty($settings[$setting]);
        }
        
        // Numeric settings
        $sanitized['cache_duration'] = max(300, min(86400, (int) ($settings['cache_duration'] ?? 3600)));
        $sanitized['lazy_load_threshold'] = max(0, min(1000, (int) ($settings['lazy_load_threshold'] ?? 200)));
        $sanitized['performance_threshold'] = max(100, min(5000, (int) ($settings['performance_threshold'] ?? 1000)));
        $sanitized['cache_headers_ttl'] = max(3600, min(31536000, (int) ($settings['cache_headers_ttl'] ?? 86400)));
        
        // Array settings
        $valid_triggers = ['post_save', 'post_delete', 'term_update'];
        $sanitized['purge_triggers'] = array_intersect($settings['purge_triggers'] ?? [], $valid_triggers);
        
        // String settings
        $sanitized['cdn_url'] = esc_url_raw($settings['cdn_url'] ?? '');
        
        // Cleanup frequency
        $valid_frequencies = array_keys($this->cleanup_frequencies);
        $sanitized['cleanup_frequency'] = in_array($settings['cleanup_frequency'] ?? '', $valid_frequencies) 
            ? $settings['cleanup_frequency'] 
            : 'weekly';
        
        // Preload pages
        $sanitized['preload_pages'] = array_map('esc_url_raw', $settings['preload_pages'] ?? []);
        
        return $sanitized;
    }
}