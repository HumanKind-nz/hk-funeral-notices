<?xml version="1.0"?>
<ruleset name="HumanKind Funeral Notices">
	<description>WordPress Coding Standards for HumanKind Funeral Notices.</description>

	<!-- Scan all PHP files in the project. -->
	<file>.</file>

	<!-- Exclude generated and third-party directories. -->
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/assets/js/vendor/*</exclude-pattern>
	<exclude-pattern>/assets/css/vendor/*</exclude-pattern>

	<!-- Use parallel processing for speed. -->
	<arg name="parallel" value="8"/>
	<arg name="extensions" value="php"/>
	<arg value="ps"/>

	<!-- Use WordPress Coding Standards. -->
	<rule ref="WordPress">
		<!-- Allow short array syntax []. -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
	</rule>

	<!-- Minimum supported WordPress version. -->
	<config name="minimum_wp_version" value="6.0"/>

	<!-- Text domain for i18n checks. -->
	<config name="text_domain" value="hk-funeral-notices"/>

	<!-- Prefixes for functions, hooks, and options. -->
	<config name="prefixes" value="hkfn_,HKFN_,HumanKind\FuneralNotices"/>
</ruleset>
